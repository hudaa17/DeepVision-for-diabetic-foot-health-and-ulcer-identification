# App Configuration
APP_NAME="Intelligent Diabetic Foot Risk Assessment Backend"
APP_ENV=development
DEBUG=true

# Database Configuration
# For local run: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/diabetic_foot
# For docker run: postgresql+asyncpg://postgres:postgrespassword@db:5432/diabetic_foot
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/diabetic_foot

# Redis Configuration
# For local run: redis://localhost:6379/0
# For docker run: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET_KEY=super_secure_jwt_access_secret_key_change_me
JWT_REFRESH_SECRET_KEY=super_secure_jwt_refresh_secret_key_change_me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Credentials (seeded on startup)
INITIAL_ADMIN_EMAIL=admin@curavision.org
INITIAL_ADMIN_PASSWORD=AdminSecure123!

# Storage Configuration
# Options: local, s3, azure
STORAGE_PROVIDER=local

# Local Storage Directory (if STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=./uploads

# AWS S3 Settings (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=diabetic-foot-risk-assessment

# Azure Blob Storage Settings (if STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_CONTAINER_NAME=diabetic-foot-container

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
